APP_NAME=Aurevo API
APP_ENV=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DB_NAME

# Generate a unique secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace_with_a_secure_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI scope generation and project copilot. Keep the key server-side only.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=12
GEMINI_MAX_ATTEMPTS=2

# PayPal Sandbox credentials. Never commit real credentials.
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id
PAYPAL_RETURN_URL=http://localhost:5173/paypal/success
PAYPAL_CANCEL_URL=http://localhost:5173/paypal/cancel

# Persistent background tasks (Celery + Redis)
REDIS_URL=redis://localhost:6379/0
MILESTONE_REVIEW_HOURS=72
MILESTONE_REMINDER_HOURS=24,48
# Optional accelerated local testing: set review minutes and reminder offsets (e.g. 5 and 1,2).
MILESTONE_REVIEW_MINUTES=0
MILESTONE_REMINDER_MINUTES=
CELERY_TASK_ALWAYS_EAGER=false
